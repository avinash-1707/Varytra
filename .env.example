# Local PostgreSQL from compose.yaml. Do not use production credentials here.
DATABASE_URL=postgres://varytra:varytra@127.0.0.1:5432/varytra
APP_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-this-with-a-random-32-character-minimum-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@example.com
# Cloudinary product-environment credentials. Do not expose the API secret to the browser.
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
