# Local PostgreSQL from compose.yaml. Do not use production credentials here.
DATABASE_URL=postgres://varytra:varytra@127.0.0.1:5432/varytra
APP_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-this-with-a-random-32-character-minimum-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@example.com
# Local MinIO from compose.yaml. The bucket must be private and pre-created.
# Retention removes all versions, but keep production bucket version access private.
S3_BUCKET=varytra-artifacts
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=varytra
S3_SECRET_ACCESS_KEY=varytra-local-only
